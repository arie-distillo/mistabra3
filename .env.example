# Copy to .env in the repository root (it is git-ignored) and fill in.
MISTABRA_PROVIDER=anthropic          # anthropic | openrouter | openai (any OpenAI-compatible endpoint) | fake
MISTABRA_MODEL=claude-sonnet-4-5     # reasoning tier: abduction, baselines, standing
MISTABRA_FAST_MODEL=claude-haiku-4-5 # operational tier: radar reads, Lambda-signal check
MISTABRA_API_KEY=
# With MISTABRA_PROVIDER=openrouter, models are OpenRouter ids, e.g.:
#   MISTABRA_MODEL=anthropic/claude-sonnet-4.5
#   MISTABRA_FAST_MODEL=anthropic/claude-haiku-4.5
# MISTABRA_BASE_URL=...              # only for openai: OpenAI, Ollama, vLLM, LM Studio, ...
# Thinking models (Qwen 3.5, Gemini, o-series, ...) spend tokens on reasoning before answering; if you get
# "empty output", turn reasoning down or raise the budget:
# MISTABRA_REASONING=none            # none | low | medium | high (default: the model's own)
# MISTABRA_MAX_TOKENS=4000
# MISTABRA_CONCURRENCY=8          # model requests in flight at once; lower it if the provider returns 429

# MISTABRA_STANDING=noisy_or         # noisy_or (computed, default) | judged (one reasoning call per episode)
