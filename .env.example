# Copy to .env in the repository root (it is git-ignored) and fill in.
MISTABRA_PROVIDER=anthropic          # anthropic | openai (any OpenAI-compatible endpoint) | fake
MISTABRA_MODEL=claude-sonnet-4-5     # reasoning tier: abduction, baselines, standing
MISTABRA_FAST_MODEL=claude-haiku-4-5 # operational tier: radar reads, Lambda-signal check
MISTABRA_API_KEY=
# MISTABRA_BASE_URL=https://openrouter.ai/api/v1   # with MISTABRA_PROVIDER=openai
